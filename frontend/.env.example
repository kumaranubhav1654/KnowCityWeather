# Frontend environment (copy to .env.local for local dev)
#
# This is the ONLY env var the Next.js app needs.
# API keys (OpenWeather, Gemini, Twilio) live in backend/.env — never here.

# Local development (default if unset):
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Production (Vercel → Settings → Environment Variables):
NEXT_PUBLIC_API_URL=https://knowcityweather-pazk.onrender.com
