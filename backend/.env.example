# Backend environment (copy to .env and fill in real values)
# Used by Express on port 3001 (Render sets PORT automatically in production)

PORT=3001
CITY=Bangalore

# Optional: your Vercel URL for tighter CORS (origin: true allows all by default)
# FRONTEND_URL=https://your-app.vercel.app

# OpenWeatherMap — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key

# Twilio WhatsApp — https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886
USER_WHATSAPP_NUMBER=+9198XXXXXXXX
